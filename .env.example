# prod/.env.example
# Production reference. In Cloud Run, these come from `gcloud run deploy --update-secrets`
# and `--set-env-vars`. This file documents what each value is and is also useful
# for `docker run` smoke tests before deploying.

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=prod
# Public URL of the Cloud Run service. Set after first deploy.
APP_BASE_URL=https://slack-assistant-XXXXXXX-uc.a.run.app
LOG_LEVEL=INFO

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── Database ───────────────────────────────────────────────────────────────
# Cloud SQL Postgres via Auth Proxy unix socket (Cloud Run's recommended pattern):
#   postgresql+asyncpg://USER:PASS@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
EXTRACTION_MODEL=claude-haiku-4-5-20251001

# ── Slack ──────────────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Google ─────────────────────────────────────────────────────────────────
# OAuth client redirect URI must equal: <APP_BASE_URL>/oauth/google/callback
# Google Ads OAuth redirect URI must equal: <APP_BASE_URL>/oauth/google-ads/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v22

# ── Wrike ──────────────────────────────────────────────────────────────────
# OAuth app redirect URI must equal: <APP_BASE_URL>/oauth/wrike/callback
WRIKE_CLIENT_ID=
WRIKE_CLIENT_SECRET=

# ── Braintrust ─────────────────────────────────────────────────────────────
# Create a project at https://www.braintrust.dev and paste the API key below.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=pronto-ads-analyst
# Tracing detail. false (default): user prompts, tool names, tool call args
# and the assistant's reply are traced in full; tool RESPONSES (Google Ads /
# Calendar / Wrike data) are traced as shape + types only, with values masked.
# true: everything raw, incl. tool responses and user email, plus Anthropic
# SDK auto-instrumentation.
TRACE_SENSITIVE_DATA=false
# Eval dataset capture. When true, every successful Google Ads agent turn is
# inserted into the "ads-analyst-turns" Braintrust dataset. Only *_pct delta
# fields are stored (no absolute spend, no campaign names).
EVAL_CAPTURE=false
