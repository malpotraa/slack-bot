# prod/.env.example
# Production reference. In Cloud Run, these come from `gcloud run deploy --update-secrets`
# and `--set-env-vars`. This file documents what each value is and is also useful
# for `docker run` smoke tests before deploying.

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=prod
# Public URL of the Cloud Run service. Set after first deploy.
APP_BASE_URL=https://slack-assistant-XXXXXXX-uc.a.run.app
LOG_LEVEL=INFO

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── Database ───────────────────────────────────────────────────────────────
# Cloud SQL Postgres via Auth Proxy unix socket (Cloud Run's recommended pattern):
#   postgresql+asyncpg://USER:PASS@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
EXTRACTION_MODEL=claude-haiku-4-5-20251001

# ── Slack ──────────────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Google ─────────────────────────────────────────────────────────────────
# OAuth client redirect URI must equal: <APP_BASE_URL>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Wrike ──────────────────────────────────────────────────────────────────
# OAuth app redirect URI must equal: <APP_BASE_URL>/oauth/wrike/callback
WRIKE_CLIENT_ID=
WRIKE_CLIENT_SECRET=

# ── Phoenix (Arize) ────────────────────────────────────────────────────────
# Phoenix Cloud free tier — recommended for production.
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
PHOENIX_PROJECT_NAME=slack-assistant
PHOENIX_API_KEY=
