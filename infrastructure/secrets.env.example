# Copy to infrastructure-secrets.env and fill in. NEVER commit the real file.
# The 02-create-secrets.sh script reads this file and uploads each value
# to Secret Manager.

# Generated locally with scripts/gen_keys.py
PRONTO_APP_SECRET_KEY=""
PRONTO_TOKEN_ENCRYPTION_KEY=""

# Printed by 01-create-cloud-sql.sh — copy the full DSN here
PRONTO_DATABASE_URL=""

# Anthropic
PRONTO_ANTHROPIC_API_KEY=""

# Slack — from api.slack.com/apps
PRONTO_SLACK_BOT_TOKEN=""
PRONTO_SLACK_APP_TOKEN=""
PRONTO_SLACK_SIGNING_SECRET=""
PRONTO_SLACK_CLIENT_ID=""
PRONTO_SLACK_CLIENT_SECRET=""

# Google — from console.cloud.google.com → APIs & Services → Credentials
PRONTO_GOOGLE_CLIENT_ID=""
PRONTO_GOOGLE_CLIENT_SECRET=""

# Google Ads — from Google Ads API Center / MCC
PRONTO_GOOGLE_ADS_DEVELOPER_TOKEN=""
PRONTO_GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# Wrike — from wrike.com/frame/oauth2/apps
PRONTO_WRIKE_CLIENT_ID=""
PRONTO_WRIKE_CLIENT_SECRET=""

# Braintrust — from braintrust.dev
PRONTO_BRAINTRUST_API_KEY=""
