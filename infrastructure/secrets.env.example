# Copy to infrastructure-secrets.env and fill in. NEVER commit the real file.
# The 02-create-secrets.sh script reads this file and uploads each value
# to Secret Manager.

# Generated locally with scripts/gen_keys.py
APP_SECRET_KEY=""
TOKEN_ENCRYPTION_KEY=""

# Printed by 01-create-cloud-sql.sh — copy the full DSN here
DATABASE_URL=""

# Anthropic
ANTHROPIC_API_KEY=""

# Slack — from api.slack.com/apps
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""
SLACK_SIGNING_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# Google — from console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Wrike — from wrike.com/frame/oauth2/apps
WRIKE_CLIENT_ID=""
WRIKE_CLIENT_SECRET=""

# Phoenix Cloud — from app.phoenix.arize.com
PHOENIX_API_KEY=""
