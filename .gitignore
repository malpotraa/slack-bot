# ─── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.egg-info/
build/
dist/
wheels/

# ─── Virtual environments ────────────────────────────────────────────────
.venv/
venv/

# ─── Caches / build artefacts ────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.log

# ─── Secrets — NEVER commit ──────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.*
# Re-include the example file — it's a template, not a secret.
!.env.example
infrastructure-secrets.env
infrastructure/secrets.env
*.pem
*.key

# ─── Local data (smoke-test SQLite; prod uses Cloud SQL) ─────────────────
data/*.db
data/*.db-journal
data/*.sqlite*

# ─── OS / editor ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.bak

# ─── Runtime junk ────────────────────────────────────────────────────────
*.pid
*.sock
.python-version

# ─── Living-context docs that should stay local ──────────────────────────
claude.md
